            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Lab 0005: Snowflake Config Driven Example",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/lessons/lab_0005_snowflake/examples/config_driven_example.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Lab 0005: Snowflake Test Connection",
            "type": "python",
            "request": "launch",
