            "request": "launch",
            "program": "${workspaceFolder}/lessons/lab_0004_ai_agent/examples/function_calling_demo.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Lab 0004: Run Function Calling Agent",
            "type": "python",
